# Database Configuration
DATABASE_URL=mysql://root:password@localhost:3306/shortener
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/shortener

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
SECRET_KEY=your_super_secret_key_change_this_in_production
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=False
ENVIRONMENT=development

# Cache Settings
CACHE_TTL=2592000  # 30 days in seconds
HOT_URL_THRESHOLD=100  # URLs with >100 clicks cached aggressively

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=1000  # Requests per minute
RATE_LIMIT_WINDOW=60

# URL Expiration
DEFAULT_EXPIRY_DAYS=0  # 0 = never expires
MAX_EXPIRY_DAYS=365

# Short Code Settings
SHORT_CODE_LENGTH=6
CUSTOM_CODE_MIN_LENGTH=3
CUSTOM_CODE_MAX_LENGTH=20

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

# Analytics
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_FLUSH_INTERVAL=300  # 5 minutes

# Logging
LOG_LEVEL=INFO
